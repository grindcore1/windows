<Window x:Class="EmployeeApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Список сотрудников"
        Height="450"
        Width="650">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Список сотрудников -->
        <ListBox Grid.Row="0"
                 ItemsSource="{Binding Employees}"
                 SelectedItem="{Binding SelectedEmployee,
                                        Mode=TwoWay}">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal"
                                Margin="5">

                        <TextBlock Text="{Binding Name}"
                                   Width="150"/>

                        <TextBlock Text="{Binding Position}"
                                   Width="150"/>

                        <TextBlock Text="{Binding Salary,
                                          StringFormat={}{0:N2}}"
                                   Width="100"/>

                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

        <!-- Поля ввода -->
        <StackPanel Grid.Row="1" Margin="0,15,0,10">

            <TextBlock Text="Имя сотрудника:"/>

            <TextBox Text="{Binding NewName,
                            UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,3,0,8"/>

            <TextBlock Text="Зарплата:"/>

            <TextBox Text="{Binding NewSalary,
                            UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,3,0,8"/>

            <TextBlock Text="Должность:"/>

            <TextBox Text="{Binding NewPosition,
                            UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,3,0,8"/>

        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">

            <Button Content="Добавить"
                    Command="{Binding AddCommand}"
                    Width="120"
                    Height="35"
                    Margin="5"/>

            <Button Content="Удалить"
                    Command="{Binding DeleteCommand}"
                    Width="120"
                    Height="35"
                    Margin="5"/>

        </StackPanel>

    </Grid>
</Window>
